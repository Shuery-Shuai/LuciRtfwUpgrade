
config globals 'globals'
	# 0 = 仅检测并通知, 1 = 检测后自动下载, 2 = 检测后自动下载并刷写
	option unattended '0'
	# 自动检测的调度：off / daily / weekly / monthly
	option schedule_kind 'daily'
	# 24 小时制时间
	option schedule_time '04:00'
	# weekly 用：1=周一 … 7=周日
	option schedule_weekday '1'
	# monthly 用：1-28
	option schedule_day '1'
	# 通用 webhook（POST JSON），留空则关闭
	option webhook ''
	# 同一时刻只激活一个源
	option active_source 'immortalwrt_official'

config source 'immortalwrt_official'
	option label 'ImmortalWrt 官方'
	option url 'https://downloads.immortalwrt.org'
	option layout 'official'
	option system ''

config source 'openwrt_official'
	option label 'OpenWrt 官方'
	option url 'https://downloads.openwrt.org'
	option layout 'official'
	option system ''

config source 'rtfw_immortalwrt'
	option label 'RTFW 聚合站（immortalwrt）'
	option url 'https://rtfw.shuery.lssa.fun'
	option layout 'official'
	option system 'immortalwrt'
