{
	"luci-app-rtfwupgrade": {
		"description": "Grant access to the LuCI router firmware update checker",
		"read": {
			"uci": ["rtfwupgrade"],
			"ubus": {
				"rtfwupgrade": ["status", "sources", "check", "version", "download_status", "logs", "schedule_status"]
			}
		},
		"write": {
			"uci": ["rtfwupgrade"],
			"ubus": {
				"rtfwupgrade": [
					"set_active",
					"set_options",
					"source_add",
					"source_set",
					"source_del",
					"download",
					"cancel",
					"cleanup",
					"logs_clear"
				]
			}
		}
	}
}
