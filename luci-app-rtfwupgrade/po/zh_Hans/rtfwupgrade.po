msgstr "检测失败："

# sources
msgid "Active"
msgstr "激活"

msgid "Name"
msgstr "名称"

msgid "Layout"
msgstr "布局"

msgid "Address"
msgstr "地址"

msgid "Only one source is active at a time. Switching discards the previous check result, so that a verdict can never come from a source you are not looking at."
msgstr "同一时刻只有一个源生效；切换会作废上一次的检测结果，避免出现「结论来自另一个源」的情况。"

msgid "Save and apply"
msgstr "保存并应用"

msgid "Active source updated."
msgstr "激活源已更新。"

msgid "Save failed"
msgstr "保存失败"

msgid "Save failed: "
msgstr "保存失败："

# settings
msgid "Unattended level"
msgstr "无人值守档位"

msgid "detect and notify"
msgstr "仅检测并通知"

msgid "download automatically"
msgstr "自动下载"

msgid "flash automatically"
msgstr "自动刷写"

msgid "Webhook URL"
msgstr "Webhook 地址"

msgid "Settings saved."
msgstr "设置已保存。"

msgid "Where settings live"
msgstr "配置存放位置"

msgid "Everything is stored in /etc/config/rtfwupgrade, which is preserved by sysupgrade -k together with the rest of the configuration."
msgstr "全部配置存放在 /etc/config/rtfwupgrade，会随 sysupgrade -k 与其他配置一起保留。"

# M2 下载
msgid "Detection and image download are read-only. Flashing is a separate step and only runs after an explicit confirmation."
msgstr "只读检测 + 镜像下载。刷写是独立的一步，只有明确确认后才会执行。"

msgid "Image download"
msgstr "镜像下载"

msgid "Downloads the candidate image to /tmp and verifies its sha256. Flashing is a separate step."
msgstr "把候选镜像下载到 /tmp 并校验 sha256。刷写是独立的一步。"

msgid "Download image"
msgstr "下载镜像"

msgid "Downloading…"
msgstr "下载中…"

msgid "The file goes to /tmp (RAM). Flashing is a separate step and only runs after an explicit confirmation."
msgstr "文件落在 /tmp（内存）。刷写是独立的一步，只有明确确认后才会执行。"

msgid "resumed"
msgstr "（续传）"

msgid "Cancel"
msgstr "取消"

msgid "Cancel failed"
msgstr "取消失败"

msgid "Cancel failed: "
msgstr "取消失败："

msgid "Downloaded and verified"
msgstr "已下载并通过校验"

msgid "The sha256 matches the one published by the source. The image is ready to flash."
msgstr "sha256 与源站公布的一致，镜像已可用于刷写。"

msgid "Download failed"
msgstr "下载失败"

msgid "Download failed: "
msgstr "下载失败："

msgid "Retry download"
msgstr "重试下载"

msgid "Resume download"
msgstr "继续下载"

msgid "Delete file"
msgstr "删除文件"

msgid "Downloaded file deleted."
msgstr "已删除下载的文件。"

msgid "Delete failed: "
msgstr "删除失败："

msgid "Download cancelled"
msgstr "下载已取消"

msgid "The partial file is kept, so a retry resumes instead of starting over (the ETag is compared first)."
msgstr "已下载的部分会保留，重试时续传而不是重来（续传前会先比对 ETag）。"

# 源管理（自定义源）与设置（定时任务）

msgid "Preset"
msgstr "预设"

msgid "— pick a preset —"
msgstr "— 选择预设 —"

msgid "Identifier"
msgstr "标识"

msgid "My mirror"
msgstr "我的镜像站"

msgid "optional, e.g. immortalwrt"
msgstr "可选，例如 immortalwrt"

msgid "System"
msgstr "系统"

msgid "path segment for mirrors that host several systems, e.g. rtfw/immortalwrt"
msgstr "聚合站的系统路径段，例如 rtfw 的 immortalwrt"

msgid "Add"
msgstr "添加"

msgid "Add failed"
msgstr "添加失败"

msgid "Add failed: "
msgstr "添加失败："

msgid "Delete"
msgstr "删除"

msgid "Delete failed"
msgstr "删除失败"

msgid "Actions"
msgstr "操作"

msgid "Source added."
msgstr "源已添加。"

msgid "Source deleted."
msgstr "源已删除。"

msgid "ImmortalWrt official"
msgstr "ImmortalWrt 官方"

msgid "OpenWrt official"
msgstr "OpenWrt 官方"

msgid "RTFW mirror"
msgstr "RTFW 聚合站"

msgid "Own bin/targets mirror"
msgstr "自有 bin/targets 站"

msgid "Own build mirror"
msgstr "自有构建站"

msgid "Scheduled task"
msgstr "定时任务"

msgid "Daily"
msgstr "每天"

msgid "Weekly"
msgstr "每周"

msgid "Disabled"
msgstr "关闭"

# 面向用户的文案（去掉开发术语）
msgid "0: detect and notify only. 1: also download automatically. 2: also flash automatically, but only when the verdict is an update; a rebuild is downloaded and left alone, and the automatic path never flashes across distributions."
msgstr "0：仅检测并通知；1：额外自动下载；2：额外自动刷写，但只在判定为「可升级」时才刷——判定为重编时只下载不刷写，自动路径也绝不跨发行版刷写。"

msgid "POST JSON when update events happen. Leave empty to disable."
msgstr "发生更新事件时以 POST JSON 通知，留空即关闭。"

msgid "Delete source"
msgstr "删除源"

msgid "Delete source %s? Its section is removed from the configuration and the last check result is discarded."
msgstr "删除源 %s？该段会从配置中移除，最近一次检测结果也会作废。"

# 结构与日志（第二轮界面意见）

msgid "Logs"
msgstr "日志"

msgid "Check sources"
msgstr "检测源"

msgid "Detection and notification"
msgstr "检测与通知"

msgid "Save settings"
msgstr "保存设置"

msgid "Detection, source and download events, newest first. Stored in RAM (/tmp), so a reboot clears them."
msgstr "检测、源与下载事件，最新的在前。写在内存（/tmp）里，重启即清空。"

msgid "Refresh"
msgstr "刷新"

msgid "Clear log"
msgstr "清空日志"

msgid "Log cleared."
msgstr "日志已清空。"

msgid "Clear failed: "
msgstr "清空失败："

msgid "Refresh failed: "
msgstr "刷新失败："

msgid "No events yet."
msgstr "还没有事件。"

msgid "No downloader output yet."
msgstr "还没有下载器输出。"

msgid "Raw downloader output (tail)"
msgstr "下载器原始输出（尾部）"

msgid "Time"
msgstr "时间"

msgid "Event"
msgstr "事件"

msgid "Detail"
msgstr "说明"

msgid "Files: %s , %s"
msgstr "文件：%s 、%s"

# 添加源：字段顺序跟随表格；标识可自动生成
msgid "fills the fields below; you can edit everything afterwards"
msgstr "会自动填入下面的字段，填完仍可修改"

msgid "shown in the table; free text, duplicates allowed"
msgstr "表格里显示的就是它；随意写，允许重复"

msgid "auto-generated when empty"
msgstr "留空则自动生成"

msgid "internal UCI section name (lower-case letters, digits, underscore); normally you do not need to set it"
msgstr "内部用的 UCI 段名（小写字母、数字、下划线）；一般不需要填"

msgid "identifier"
msgstr "标识"

# 调度与日志筛选（第四轮界面意见）
msgid "Runs unattended on this schedule. It will be written into /etc/crontabs/root inside its own marked block and never touches your existing entries."
msgstr "按此时刻表无人值守执行。会写进 /etc/crontabs/root 的独立标记块，绝不改动你已有的条目。"

msgid "Monthly"
msgstr "每月"

msgid "Weekday"
msgstr "星期"

msgid "Day of month"
msgstr "号数"

msgid "1-28 only, so that every month triggers"
msgstr "只提供 1-28，避免 29-31 号在某些月份不触发"

msgid "Time (24h)"
msgstr "时间（24 小时制）"

msgid "The scheduled check is disabled."
msgstr "定时检测已关闭。"

msgid "Monday"
msgstr "周一"

msgid "Tuesday"
msgstr "周二"

msgid "Wednesday"
msgstr "周三"

msgid "Thursday"
msgstr "周四"

msgid "Friday"
msgstr "周五"

msgid "Saturday"
msgstr "周六"

msgid "Sunday"
msgstr "周日"

msgid "Level"
msgstr "级别"

msgid "All levels"
msgstr "全部级别"

msgid "All events"
msgstr "全部事件"

msgid "Search"
msgstr "搜索"

msgid "substring of the message"
msgstr "按说明内容模糊匹配"

msgid "Shown %d of %d events"
msgstr "显示 %d / %d 条事件"

msgid "No events match the filter."
msgstr "没有符合筛选条件的事件。"

# 快速添加行 + 高级对话框
msgid "The last row is the quick add: fill the required fields and press Add. Use Advanced when you need to set the identifier yourself."
msgstr "表格最后一行是快速添加：填必填项后点「添加」。需要自己指定标识等参数时点「高级」。"

msgid "Advanced"
msgstr "高级"

msgid "Quick add needs a label and an address at least — use Advanced for the rest."
msgstr "快速添加至少需要名称与地址；其它参数请用「高级」。"

msgid "Own"
msgstr "自有"

# 与 luci-base 的「卷标」区分开：同一个概念统一叫「名称」
msgid "Source label"
msgstr "名称"

# 对话框与快速添加行共用的文案
msgid "Add source"
msgstr "添加源"

msgid "optional placeholder"
msgstr "可选"

msgid "Overview"
msgstr "概览"

# 布局说明：official / default 的固定目录结构
# 标题单独一条：这两行会出现在源表格之外，必须先说明「这是布局类型」，
# 否则用户会看到两行孤立文本（界面评审反馈）。
msgid "Layout types"
msgstr "布局类型"

msgid "OpenWRT/ImmortalWRT official release page structure: root/releases/release/targets"
msgstr "OpenWRT/ImmortalWRT 官方发布页结构 root/releases/release/targets"

msgid "Default build output directory structure: root/targets"
msgstr "默认编译输出目录结构 root/targets"

# 源编辑（source_set）
msgid "Edit"
msgstr "编辑"

msgid "Edit source"
msgstr "编辑源"

msgid "It is the UCI section name and cannot be changed."
msgstr "它是内部 UCI 段名，不可修改。"

msgid "Save"
msgstr "保存"

msgid "Source updated."
msgstr "源已更新。"

msgid "Update failed"
msgstr "更新失败"

msgid "Update failed: "
msgstr "更新失败："

# 定时任务状态（schedule_status）
msgid "Scheduled task status"
msgstr "定时任务状态"

msgid "Written to crontab"
msgstr "已写入"

msgid "Not written"
msgstr "未写入"

msgid "Out of sync"
msgstr "不一致"

msgid "Wanted"
msgstr "期望"

msgid "Applied"
msgstr "实际"

msgid "Crontab path: %s"
msgstr "crontab 路径：%s"

msgid "The managed block matches the current schedule."
msgstr "受管块与当前调度一致。"

msgid "The managed block differs from the current schedule; save the settings to rewrite it."
msgstr "受管块与当前调度不一致；保存设置即可重写。"

msgid "The scheduled task is off, so no crontab entry is expected."
msgstr "定时任务已关闭，因此不应存在 crontab 条目。"

msgid "The managed block has not been written yet; save the settings to write it."
msgstr "受管块尚未写入；保存设置即可写入。"

msgid "A managed crontab block is still present; save the settings to remove it."
msgstr "仍残留受管 crontab 块；保存设置即可移除。"

msgid "The schedule status is not available yet. Save the settings once to sync the crontab."
msgstr "暂时读不到定时任务状态；保存一次设置即可同步 crontab。"

# 下载续传检查原因
msgid "Resume check: %s"
msgstr "续传检查：%s"

# 日志：定时任务原始输出
msgid "Raw scheduled-task output (tail)"
msgstr "定时任务原始输出（尾部）"

msgid "No scheduled-task output yet."
msgstr "还没有定时任务输出。"

msgid "Scheduled-task log: %s"
msgstr "定时任务日志：%s"
# M3 刷写（前端 → rpcd → flash.uc）
msgid "Flash firmware"
msgstr "刷写固件"

msgid "Target version"
msgstr "目标版本"

msgid "Target build id"
msgstr "目标构建"

msgid "Image file"
msgstr "镜像文件"

msgid "Image size"
msgstr "镜像体积"

msgid "This cannot be undone"
msgstr "此操作不可逆"

msgid "Flashing reboots the router: the network drops until it is back, and everything written to /tmp is lost. Existing configuration is kept, because sysupgrade runs with -k -c."
msgstr "刷写会重启设备：重启期间断网，/tmp 里的内容全部丢失。系统刷写用 -k -c 执行，因此现有配置会保留。"

msgid "I confirm: flash this image and reboot the router."
msgstr "我确认：刷写这个镜像并重启设备。"

msgid "Allow cross-distribution flashing (force)"
msgstr "允许跨发行版刷写（force）"

msgid "Cross-distribution change"
msgstr "跨发行版更换"

msgid "Flash now"
msgstr "立即刷写"

msgid "The command is: %s"
msgstr "将执行命令：%s"

msgid "No blocking problem found so far."
msgstr "目前没有发现阻断问题。"

msgid "Flashing is blocked"
msgstr "刷写被阻断"

msgid "Flashing is blocked: fix the problems listed above."
msgstr "刷写被阻断：请先解决上面列出的问题。"

msgid "Flashing failed: "
msgstr "刷写失败："

msgid "A flash is already pending. Reboot the router and let the boot check confirm it first."
msgstr "已有一笔刷写待重启确认。请先重启设备，让开机检查确认结果。"

msgid "Run a check first: nothing tells which image this device should be flashed with."
msgstr "请先做一次检测：现在没有任何依据能确定该刷哪个镜像。"

msgid "The image has not been downloaded and verified yet."
msgstr "镜像还没有下载并通过校验。"

msgid "This source belongs to a different distribution. Tick the cross-distribution override first."
msgstr "该源属于另一个发行版。请先勾选跨发行版放行。"

msgid "Waiting for reboot confirmation"
msgstr "等待重启确认"

msgid "The image was written and sysupgrade was started. The state is confirmed after the router reboots."
msgstr "镜像已写入、刷写已发起。设备重启后才会确认这次刷写的结果。"

msgid "Flash confirmed after reboot"
msgstr "重启后已确认刷写成功"

msgid "The build id after reboot matches the target: %s"
msgstr "重启后的构建标识与目标一致：%s"

msgid "Flash not confirmed"
msgstr "刷写未被确认"

msgid "After reboot the build id is %s while the target was %s."
msgstr "重启后的构建标识是 %s，而目标是 %s。"

msgid "Clear flash state"
msgstr "清除刷写状态"

msgid "Flash state cleared."
msgstr "刷写状态已清除。"
